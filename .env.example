# Optional explicit browser origins (comma separated); same-origin SPA needs none.
CORS_ORIGINS=
# Keep refresh cookies Secure in HTTPS/staging/production; set false only for local plain-HTTP development.
COOKIE_SECURE=true
# Login failures are limited over a rolling window (username+client and aggregate client buckets).
# Uses the direct request peer, not X-Forwarded-For; configure trusted-proxy/ingress limits when deployed behind a proxy.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PER_USERNAME_IP=5
LOGIN_RATE_LIMIT_PER_IP=25
# Default is live/safe mode: no demo accounts or simulator messages are enabled.
DEMO_MODE=false
# For first live bootstrap only, supply a unique username and a strong temporary password via a secret manager.
# With an empty user table this creates a Chief Registrar who must change the password at first sign-in.
COURTLOG_BOOTSTRAP_USERNAME=
COURTLOG_BOOTSTRAP_PASSWORD=
COURTLOG_BOOTSTRAP_NAME=
SIMULATOR_SECRET=
# Optional runtime storage path; tests always use a temporary database.
# COURTLOG_DB_PATH=/absolute/path/courtlog.db
# JWT_PRIVATE_KEY_PATH=/absolute/path/private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/public.pem
# Optional directory for versioned delay-risk model artifacts (default: ./data).
# COURTLOG_MODEL_DIR=/var/lib/courtlog/model-artifacts

# Meta WhatsApp Cloud API: disabled by default. DEMO_MODE=true always prevents real sends.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Verify the currently supported Graph API version in Meta's app dashboard before deployment.
WHATSAPP_API_VERSION=v26.0
# Must name an approved, utility-category template with no body variables.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Generate once (e.g. openssl rand -hex 32), store in a secret manager, and keep stable across deploys.
WHATSAPP_CONSENT_HASH_KEY=
# Internal version label for the consent notice/evidence process; it is not the consent text itself.
WHATSAPP_CONSENT_NOTICE_VERSION=courtlog-demo-v1
