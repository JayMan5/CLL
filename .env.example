# Optional explicit browser origins (comma separated); same-origin SPA needs none.
CORS_ORIGINS=
# Keep refresh cookies Secure in HTTPS/staging/production; set false only for local plain-HTTP development.
COOKIE_SECURE=true
# Default is live/safe mode: no demo accounts or simulator messages are enabled.
DEMO_MODE=false
# For first live bootstrap only, supply a unique username and a strong temporary password via a secret manager.
# With an empty user table this creates a Chief Registrar who must change the password at first sign-in.
COURTLOG_BOOTSTRAP_USERNAME=
COURTLOG_BOOTSTRAP_PASSWORD=
COURTLOG_BOOTSTRAP_NAME=
SIMULATOR_SECRET=
# Optional runtime storage path; tests always use a temporary database.
# COURTLOG_DB_PATH=/absolute/path/courtlog.db
# JWT_PRIVATE_KEY_PATH=/absolute/path/private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/public.pem
WHATSAPP_WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook-simulator
