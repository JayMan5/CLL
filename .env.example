# Optional explicit browser origins (comma separated); same-origin SPA needs none.
CORS_ORIGINS=
# Keep demo simulator disabled for live deployments.
DEMO_MODE=false
SIMULATOR_SECRET=
# Optional runtime storage path; tests always use a temporary database.
# COURTLOG_DB_PATH=/absolute/path/courtlog.db
# JWT_PRIVATE_KEY_PATH=/absolute/path/private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/public.pem
WHATSAPP_WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook-simulator
